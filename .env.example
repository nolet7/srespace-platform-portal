# GitHub OAuth App credentials
# Create from GitHub > Settings > Developer settings > OAuth Apps
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:7007/api/auth/github/handler/frame
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret

# GitHub Personal Access Token for catalog discovery and repo integration
GITHUB_TOKEN=replace_with_github_pat

# Backstage auth variables mapped from GitHub OAuth values
AUTH_GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID}
AUTH_GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET}

# Local PostgreSQL for Backstage
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=backstage
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_DATABASE=backstage
