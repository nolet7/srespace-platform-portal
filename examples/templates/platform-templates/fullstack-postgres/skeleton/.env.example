# Application
APP_NAME=${{ values.component_id }}
APP_ENV=dev
APP_PORT=8000

# Frontend
FRONTEND_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=changeme-dev-password

# Observability
METRICS_ENABLED=true
LOG_LEVEL=info

# Security
SECRET_KEY=change-this-local-dev-secret
